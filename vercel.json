{
  "functions": {
    "api/analizar-notificar-v2.js": {
      "maxDuration": 300
    },
    "api/obtener-oportunidades.js": {
      "maxDuration": 10
    },
    "api/empresas.js": {
      "maxDuration": 10
    },
    "api/resultados.js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/perfil.js": {
      "maxDuration": 10
    },
    "api/confirmar-email.js": {
      "maxDuration": 10
    },
    "api/password.js": {
      "maxDuration": 10
    },
    "api/admin.js": {
      "maxDuration": 10
    },
    "api/stripe.js": {
      "maxDuration": 10
    },
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/business-features.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "compita.umbusk.com"
        }
      ],
      "destination": "https://compita.do/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/reportes/:clave",
      "destination": "/reporte-sector.html"
    }
  ],
  "crons": [
    {
      "path": "/api/analizar-notificar-v2?action=disparar&workflow=actualizar-vigentes.yml",
      "schedule": "40 11 * * 1-5"
    },
    {
      "path": "/api/analizar-notificar-v2?action=disparar&workflow=actualizar-vigentes.yml",
      "schedule": "40 16 * * 1-5"
    }
  ]
}
